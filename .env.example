# Copy to `.env` and fill in from your Supabase project:
#   Dashboard → Project Settings → Data API  (Project URL)
#   Dashboard → Project Settings → API Keys  (anon / publishable key)
#
# These are read at build time and baked into the APK, so both phones are
# connected the moment they install it. The anon key is safe to ship: every
# table is guarded by row-level security (see supabase/schema.sql).
#
# Leaving them blank is also fine — the app then asks for them on first launch.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-key-here
